<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        margin: 0;
        background-color: #fff;
        font-family: "Outfit", sans-serif;
      }
      .content-wrapper {
        border: 1px solid #d3d3d3;
        border-radius: 12px;
        width: 95%;
        max-width: 600px;
        margin: 30px auto;
        padding: 20px;
        box-sizing: border-box;
      }
      .header-wrapper {
        display: flex;
        justify-content: center;
      }
      .header-box {
        background: #97c15c;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        display: flex;
        justify-content: center;
        width: 560px;
      }
      .header-box h1 {
        font-size: 48px;
        margin: 0;
        color: #fff;
      }
      .main-box {
        border: 2px solid black;
        border-radius: 10px;
        width: 90%;
        max-width: 450px;
        margin: 20px auto;
        padding: 20px;
        text-align: center;
      }
      .main-box p {
        font-size: 12px;
        color: #555;
      }
      .main-box p:first-child {
        color: #333;
      }
      .reset-button {
        padding: 6px;
        border: 2px solid #97c15c;
        color: #97c15c;
        border-radius: 4px;
        cursor: pointer;
        transition: background-color 0.3s;
        background-color: transparent;
      }
      .reset-button:hover {
        background-color: #97c15c;
        color: white;
      }
      .footer {
        text-align: center;
        color: #666;
        font-size: 12px;
        margin-top: 20px;
      }
    </style>
  </head>

  <body>
  <div class="content-wrapper">
    <!-- Header -->
    <div class="header-wrapper">
      <div class="header-box">
        <h1>{{appName}}</h1>
      </div>
    </div>

    <!-- Main Content Box -->
    <div class="main-box">
      <p>
        It seems you've forgotten your password. No worries, it happens to the
        best of us.
      </p>
      <!-- Insert reset code here -->
      <button class="reset-button">Reset Password</button>
      <p>This link will expire in {{endTime}}.</p>
      <p>
        If you did not request this, please ignore this email or contact
        support.
      </p>
    </div>

    <!-- Footer -->
    <div class="footer">{{year}}, Aleh. All rights reserved.</div>
    </div>
  </body>
</html>