<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap');
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #ffffff; font-family: 'Outfit', sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #ffffff;">
      <tr>
        <td align="center">
          <!-- Wrapper -->
          <table width="95%" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px; border: 1px solid #d3d3d3; border-radius: 12px; padding: 20px; box-sizing: border-box;">
            <!-- Header -->
            <tr>
              <td align="center" style="padding-bottom: 20px;">
                <table width="560" cellpadding="0" cellspacing="0" border="0" style="background-color: #97c15c; border-radius: 10px;">
                  <tr>
                    <td align="center" style="padding: 20px;">
                      <h1 style="margin: 0; font-size: 48px; color: #ffffff; font-family: 'Outfit', sans-serif;">{{appName}}</h1>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td align="center">
                <table width="90%" cellpadding="0" cellspacing="0" border="0" style="max-width: 450px; border: 2px solid #000000; border-radius: 10px; padding: 20px; text-align: center;">
                  <tr>
                    <td style="font-size: 12px; color: #333333; padding-bottom: 10px;">
                      It seems you've forgotten your password. No worries, it happens to the best of us.
                    </td>
                  </tr>
                  <tr>
                    <td style="padding-bottom: 20px;">
                      <a href="{{resetLink}}" target="_blank" style="display: inline-block; padding: 10px 20px; border: 2px solid #97c15c; border-radius: 4px; color: #97c15c; text-decoration: none; transition: background-color 0.3s; font-size: 14px;">
                        Reset Password
                      </a>
                    </td>
                  </tr>
                  <tr>
                    <td style="font-size: 12px; color: #555555; padding-bottom: 10px;">
                      This link will expire in {{tokenExpires}}.
                    </td>
                  </tr>
                  <tr>
                    <td style="font-size: 12px; color: #555555;">
                      If you did not request this, please ignore this email or contact support.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align="center" style="padding-top: 20px; font-size: 12px; color: #666666;">
                {{year}}, Aleh. All rights reserved.
              </td>
            </tr>
          </table>
          <!-- End Wrapper -->
        </td>
      </tr>
    </table>
  </body>
</html>
